FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solverFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.000002;

deltaT          0.000001;

writeControl    timeStep;//adjustableRunTime;

writeInterval   1; //0.01;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  true;

maxCo   1;

functions
{
    
            #includeFunc    wallShearStress
}

