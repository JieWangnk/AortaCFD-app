FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 3;

method          simple;

simpleCoeffs
{
    n               ( 1 1 3 );
}

hierarchicalCoeffs
{
    n               ( 4 2 1 );
    order           xyz;
}


