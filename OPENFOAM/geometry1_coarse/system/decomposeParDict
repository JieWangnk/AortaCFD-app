FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains  2;

/*
    Main methods are:
    1) Geometric: "simple"; "hierarchical", with ordered sorting, e.g. xyz, yxz
    2) Scotch: "scotch", when running in serial; "ptscotch", running in parallel
*/

method              scotch; //scotch; //ptscotch; //simple; //hierarchical;

simpleCoeffs
{
    n               (4 2 1); // total must match numberOfSubdomains
}

hierarchicalCoeffs
{
    n               (4 2 1); // total must match numberOfSubdomains
    order           xyz;
}


