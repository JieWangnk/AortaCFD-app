{
  "_description": "TEST CASE: ZeroGradient outlets with one fixed pressure outlet",
  "_profile_recommendation": "sim_rans_coarse", 
  "_methodology": "Simple zeroGradient boundary conditions for stability testing",
  "geometry": {
    "refinement_level": "coarse",
    "rotation": true,
    "target_normal": [0, 0, 1],
    "scale_factor": 0.001
  },
  "mesh": {
    "SNAPPY_SETTINGS": {
      "parallel": false,
      "surfaceRefinementLevels": [1, 2],
      "featureLevel": 2
    }
  },
  "inlet": {
    "type": "TIMEVARYING",
    "csv_file": "BPM75.csv",
    "data_type": "velocity", 
    "profile": "womersley",
    "orientation": "out"
  },
  "outlets": {
    "type": "ZEROGRADIENT",
    "outlet_settings": {
      "outlet1": {
        "type": "fixedValue",
        "pressure": 0
      },
      "outlet2": {
        "type": "zeroGradient"
      },
      "outlet3": {
        "type": "zeroGradient"
      },
      "outlet4": {
        "type": "zeroGradient"
      }
    }
  },
  "simulation_control": {
    "number_of_cycles": 1,
    "end_time": 0.8,
    "target_runtime_minutes": 60,
    "writeInterval": 0.01
  },
  "numerical_settings": {
    "time_stepping": "adaptive",
    "initial_deltaT": 1e-3,
    "maxCo": 1.0,
    "maxDeltaT": 1e-2,
    "solver_tolerance": "balanced"
  }
}