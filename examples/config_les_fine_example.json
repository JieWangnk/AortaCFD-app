{
  "case_info": {
    "patient_id": "example_case_les",
    "description": "Example LES simulation with fine resolution",
    "heart_rate": 75,
    "notes": "Example showing LES WALE subgrid model setup. Computationally expensive - requires significant resources (32+ GB RAM, 16+ cores)"
  },

  "simulation_settings": {
    "solver_type": "les",
    "analysis_type": "fine"
  },

  "physics": {
    "blood_density": 1060,
    "blood_viscosity": 0.004
  },

  "geometry": {
    "scale_factor": 0.001,
    "rotation": false
  },

  "computational": {
    "parallel": true,
    "max_processors": 16
  },

  "mesh": {
    "boundary_layers": {
      "target_yplus": 1.0,
      "estimation_method": "auto"
    },
    "_comment_yplus": "LES wall-resolved: target y+ ~ 1.0 for DNS-like near-wall resolution",
    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 16,
      "addLayer": 7,
      "_comment_layers": "7 layers for LES to capture fine boundary layer structures",
      "expansionRatio": 1.1,
      "_comment_expansion": "1.1 = gentle 10% growth for LES (avoid sudden transitions)",
      "finalLayerThickness": null,
      "_comment_final": "AUTO-CALCULATED from target_yplus (will be very fine ~0.05-0.1mm)",
      "minThickness": 0.05
    }
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 16,
    "decomposition_method": "scotch",
    "skip_reconstruction": true
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "BPM75.csv",
      "data_type": "flowRate",
      "profile": "womersley",
      "orientation": "out"
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "flow_split": 40,
        "flow_split_method": "murray",
        "pwv_method": "empirical",
        "tau": 1.8
      }
    },
    "walls": {
      "type": "no_slip"
    }
  },

  "simulation_control": {
    "number_of_cycles": 10,
    "end_time": "auto",
    "writeInterval": 0.005,
    "maxCo": 0.5
  }
}
