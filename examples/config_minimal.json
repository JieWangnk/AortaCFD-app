{
  "_doc": "Minimal AortaCFD config - uses defaults where possible",

  "physics": {
    "model": "laminar"
  },

  "numerics": {
    "profile": "standard"
  },

  "mesh": {
    "SNAPPY_SETTINGS": {
      "cells_across_span": 15
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet"],
    "wall_keywords_ordered": "wall",
    "scale_factor": 0.001
  },

  "boundary_conditions": {
    "inlet": {
      "type": "CONSTANT",
      "cardiac_output": 5.0
    },
    "outlets": {
      "type": "zeroGradient"
    }
  },

  "simulation_control": {
    "end_time": 1.0
  },

  "run_settings": {
    "solution_type": "serial"
  }
}
