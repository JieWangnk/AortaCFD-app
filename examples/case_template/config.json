{
  "_doc": "AortaCFD case config — copy this folder to cases_input/<case_id>/ and edit",

  "case_info": {
    "patient_id": "MY_CASE",
    "description": "Short description of this case"
  },

  "provenance": {
    "geometry_source": "e.g. CT angiography, scan ID",
    "segmentation_tool": "e.g. SimVascular, 3D Slicer",
    "inlet_data_source": "e.g. 4D flow MRI, Doppler, literature",
    "created_by": "",
    "created_date": "",
    "notes": ""
  },

  "cardiac_cycle": 0.8,

  "physics": {
    "model": "laminar",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6
    }
  },

  "numerics": {
    "profile": "standard"
  },

  "mesh": {
    "cells_per_diameter": 15,
    "boundary_layers": {
      "enabled": true,
      "num_layers": 5,
      "expansion_ratio": 1.2,
      "final_layer_thickness": 0.3
    },
    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 4
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001,
    "_comment": "scale_factor converts STL units to meters (0.001 = mm to m)"
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "flowrate.csv",
      "data_type": "flowrate",
      "profile": "parabolic"
    },
    "outlets": {
      "type": "zeroGradient"
    },
    "walls": {
      "type": "no_slip"
    }
  },

  "hemodynamics": {
    "runtime_functions": {
      "wallShearStress": true,
      "fieldAverage": true,
      "pressureMonitoring": true
    },
    "tawss_settings": {
      "skip_cycles": 1,
      "periodicRestart": true
    }
  },

  "simulation_control": {
    "number_of_cycles": 3,
    "writeInterval": 0.04
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 4,
    "decomposition_method": "scotch"
  }
}
