{
  "_doc": "Workshop-quick variant with 2-element Windkessel (R-C) outlets instead of zeroGradient + fixed-pressure anchor. Trade-off: gives a physical resistance-driven pressure-drop story (more clinically meaningful) at the cost of a startup transient (Windkessel ODE state takes a few timesteps to settle). Compare timings against config_workshop_quick.json on the same geometry to decide which BC is better for your workshop.",

  "case_info": {
    "patient_id": "WORKSHOP_CASE",
    "description": "Workshop quick-demo, resistance outlets (config_workshop_quick_resistance.json template)"
  },

  "cardiac_cycle": 0.2,

  "physics": {
    "model": "laminar",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6
    }
  },

  "numerics": {
    "profile": "robust",
    "correctors": {
      "nOuterCorrectors": 3,
      "nCorrectors": 2,
      "nNonOrthogonalCorrectors": 1
    }
  },

  "mesh": {
    "cells_per_diameter": 8,
    "boundary_layers": {
      "enabled": false
    },
    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 4,
      "surfaceRefinementLevels": [1, 1]
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001
  },

  "boundary_conditions": {
    "inlet": {
      "type": "CONSTANT",
      "cardiac_output": 3.0,
      "profile": "plug"
    },
    "outlets": {
      "_comment": "2-element Windkessel (R-C only, no proximal Z) — simpler than 3-element and faster startup. Murray's law auto-tunes per-outlet R and C based on outlet diameter.",
      "type": "2EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "methodology": "murray_law_automatic",
        "tau": 1.0
      }
    },
    "walls": {
      "type": "no_slip"
    }
  },

  "simulation_control": {
    "cardiac_cycle_period": 0.2,
    "number_of_cycles": 1,
    "writeInterval": 0.02
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 4,
    "decomposition_method": "scotch"
  }
}
