FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      sampleDict;
}

interpolationScheme cellPoint;
libs            ("libsampling.so");
type            surfaces; 
surfaceFormat   raw;
fields          ();
surfaces
(
        points    
        {
        type        triSurfaceMesh;  
        surface     "inlet.stl"; 
        source      cells;  
        interpolate true;
        }
);


