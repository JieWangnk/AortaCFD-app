FoamFile
{
    format      binary;
    class       volScalarField;
    location    "1e-06";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    wall_aorta
    {
        type            zeroGradient;
    }
    inlet
    {
        type            zeroGradient;
    }
    outlet1
    {
        type            WKBC;
        index           0;
        value           uniform 0;
    }
    outlet2
    {
        type            WKBC;
        index           1;
        value           uniform 0;
    }
    outlet3
    {
        type            WKBC;
        index           2;
        value           uniform 0;
    }
    outlet4
    {
        type            WKBC;
        index           3;
        value           uniform 0;
    }
}


