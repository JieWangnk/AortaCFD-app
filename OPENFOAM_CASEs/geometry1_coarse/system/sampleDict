FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}

interpolationScheme cellPoint;
setFormat       raw;
surfaceFormat   foam;

type            surfaces;

fields          ();
surfaces
(
        triSurfaceSampling    {
        type        triSurfaceMesh;  
        surface     inlet.stl; 
        source      cells;  
        interpolate true;
    }
);

