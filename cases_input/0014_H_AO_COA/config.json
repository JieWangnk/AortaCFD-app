{
  "case_info": {
    "patient_id": "0014_H_AO_COA",
    "description": "Pediatric aortic coarctation case from SimVascular VMR",
    "clinical_data": {
      "sex": "Male",
      "age": 5,
      "BSA": 0.69,
      "cardiac_index": 3.51
    }
  },

  "physics": {
    "model": "les",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7735849056603773e-06,
      "_comment": "SimVascular: rho=1.06 g/cm³, mu=0.04 g/(cm·s) → nu=mu/rho=0.04/1.06 cm²/s = 3.7736e-6 m²/s"
    }
  },

  "numerics": {
    "profile": "robust",
    "max_co": 0.5,
    "_max_co_comment": "Reduced from 1.0 for fine mesh stability",

    "correctors": {
      "nOuterCorrectors": 5,
      "nCorrectors": 3,
      "nNonOrthogonalCorrectors": 3,
      "_comment": "Increased for better convergence with recirculation zones"
    },

    "relaxation_factors": {
      "p": 0.1,
      "U": 0.3,
      "_comment": "More conservative relaxation for fine mesh stability"
    }
  },

  "mesh": {
    "cells_per_diameter": 4,

    "boundary_layers": {
      "enabled": true,
      "num_layers": 10,
      "expansion_ratio": 1.1,
      "final_layer_thickness": 0.2,
      "min_thickness": 0.02,
      "relativeSizes": true
    },

    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 12,
      "surfaceRefinementLevels": [2, 3]
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4", "outlet5"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.01,
    "_comment": "SimVascular geometry is in cm, scale 0.01 converts to meters",
    "simvascular_face_mapping": {
      "inlet": "inflow",
      "outlet1": "btrunk",
      "outlet2": "rt_carotid",
      "outlet3": "carotid",
      "outlet4": "subclavian",
      "outlet5": "outflow"
    }
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "inflow.csv",
      "data_type": "flowrate",
      "profile": "parabolic",
      "_comment": "Pulsatile flowrate waveform (Time,Flowrate columns in m^3/s). Works for fresh clones — the CSV is tracked in this directory."
    },

    "_inlet_alternative_mapped_profile": {
      "_type": "MAPPED_PROFILE",
      "_file": "./inlet/",
      "_comment": "Alternative if you have the pre-mapped per-face per-timestep data: drop a 'inlet/' directory of OpenFOAM-format time snapshots in this case and switch type. NOTE: the inlet/ directory is gitignored (19MB) so fresh clones do NOT include it. Use this only if you have the data locally."
    },

    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 106,
        "diastolic_pressure": 72,
        "venous_pressure": 0,
        "initial_pressure_method": "map",

        "enable_stabilization": true,
        "stabilization_type": "simple",
        "beta": 1.0,
        "_stabilization_comment": "Full backflow suppression for fine mesh with strong recirculation",

        "_comment": "Direct RCZ mode: values converted from SimVascular CGS to SI units",
        "_conversion": "R,Z: dyne·s/cm⁵ × 1e5 = Pa·s/m³; C: cm⁵/dyne × 1e-5 = m³/Pa",
        "_simvascular_rcrt": "rcrt.dat format: Rp(Z), C, Rd(R) in CGS units",
        "outlet_parameters": {
          "outlet1": {
            "_simvascular_name": "btrunk",
            "_cgs": {"Rp": 1383.0, "C": 0.00012504, "Rd": 14883.0},
            "Z": 1.383e8,
            "C": 1.2504e-9,
            "R": 1.4883e9
          },
          "outlet2": {
            "_simvascular_name": "rt_carotid",
            "_cgs": {"Rp": 1530.0, "C": 7.976e-05, "Rd": 23969.0},
            "Z": 1.530e8,
            "C": 7.976e-10,
            "R": 2.3969e9
          },
          "outlet3": {
            "_simvascular_name": "carotid",
            "_cgs": {"Rp": 1530.0, "C": 7.976e-05, "Rd": 23969.0},
            "Z": 1.530e8,
            "C": 7.976e-10,
            "R": 2.3969e9
          },
          "outlet4": {
            "_simvascular_name": "subclavian",
            "_cgs": {"Rp": 6769.0, "C": 2.704e-05, "Rd": 68446.0},
            "Z": 6.769e8,
            "C": 2.704e-10,
            "R": 6.8446e9
          },
          "outlet5": {
            "_simvascular_name": "outflow",
            "_cgs": {"Rp": 354.0, "C": 0.0004884, "Rd": 3810.0},
            "Z": 3.54e7,
            "C": 4.884e-9,
            "R": 3.810e8
          }
        }
      }
    },

    "walls": {
      "type": "no_slip"
    }
  },

  "simulation_control": {
    "cardiac_cycle_period": 0.845,
    "number_of_cycles": 10,
    "writeInterval": 0.0005,
    "_keep_last_cycles": 2,
    "_comment": "SimVascular: 5424 timesteps × 0.00141s ≈ 7.65s ≈ 9 cycles"
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 12,
    "decomposition_method": "scotch"
  }
