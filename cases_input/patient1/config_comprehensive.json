{
  "_comment": "COMPREHENSIVE AORTACFD CONFIG - All Possible Options",
  "_documentation": "This config shows ALL available options. Remove unused sections for your case.",

  "case_info": {
    "patient_id": "patient1",
    "description": "Complex aortic geometry with multiple branches",
    "study_id": "STUDY_001",
    "acquisition_date": "2025-01-15"
  },

  "simulation_settings": {
    "analysis_type": "medium",
    "_analysis_type_options": ["coarse", "medium", "fine"],
    "solver_type": "laminar",
    "_solver_type_options": ["laminar", "LES", "RANS"]
  },

  "physics": {
    "_comment": "Blood properties and physical parameters",
    "blood_density": 1060,
    "_density_range": "1000-1200 kg/m³ (normal ~1060)",
    "blood_viscosity": 0.004,
    "_viscosity_range": "0.001-0.01 Pa·s (normal ~0.004)",
    "default_temperature": 310,
    "_temperature_note": "Body temperature in Kelvin (37°C = 310K)",

    "_turbulence_models": {
      "laminar": "No turbulence model - direct simulation",
      "RAS": "Reynolds-Averaged Simulation (RANS)",
      "LES": "Large Eddy Simulation"
    },

    "simulation_type": "laminar",
    "_simulation_type_options": ["laminar", "RAS", "LES"],

    "_rans_specific_settings": {
      "turbulence_model": "kOmegaSST",
      "turbulence_intensity": 0.05,
      "_turbulence_intensity_range": "0.05-0.08 (5-8%)",
      "turbulence_viscosity_ratio": 10.0,
      "_viscosity_ratio_range": "10-12"
    },

    "_les_specific_settings": {
      "simulation_performance": "high",
      "steady_state": false,
      "filter_width": "cubeRootVol",
      "subgrid_model": "WALE",
      "_subgrid_model_options": ["WALE", "Smagorinsky"],
      "smagorinsky_constant": 0.18
    }
  },

  "geometry": {
    "_comment": "Geometry transformation and scaling",
    "rotation": true,
    "target_normal": [0, 0, 1],
    "_target_normal_note": "Desired inlet normal direction after rotation",
    "scale_factor": 0.001,
    "_scale_factor_note": "0.001 = mm to m conversion",

    "_auto_discovered_fields": {
      "case_name": "Set automatically from patient folder",
      "wall_keywords_ordered": "Detected from wall*.stl files",
      "inlet_keywords_ordered": "Detected from inlet*.stl files",
      "outlet_keywords_ordered": "Detected from outlet*.stl files (sorted)"
    }
  },

  "mesh": {
    "_comment": "Mesh generation settings",

    "mesh_resolution": {
      "target_cell_size_mm": 1.0,
      "_cell_size_options": {
        "coarse": "1.8 mm (~1.5M cells)",
        "medium": "1.0 mm (~3.5M cells)",
        "fine": "0.6 mm (~7M cells)"
      },

      "blockmesh_resolution": 60,
      "_blockmesh_note": "Base blockMesh divisions (auto-calculated if omitted)",

      "cells_per_diameter": {
        "inlet": 15,
        "branch": 12,
        "_coarse": {"inlet": 8, "branch": 6},
        "_medium": {"inlet": 15, "branch": 12},
        "_fine": {"inlet": 22, "branch": 18}
      },

      "refinement_targets_mm": {
        "background": 0.0015,
        "surface": 0.001,
        "feature": 0.0007,
        "_note": "Target cell sizes for different regions"
      }
    },

    "SNAPPY_SETTINGS": {
      "_comment": "snappyHexMesh settings",
      "parallel": true,
      "nProcessors": 4,
      "_nProcessors_note": "Number of cores for meshing (1 for serial)",

      "maxLocalCells": 3800000,
      "maxGlobalCells": 4000000,
      "_cell_limits_by_resolution": {
        "coarse": {"local": 1800000, "global": 2000000},
        "medium": {"local": 3800000, "global": 4000000},
        "fine": {"local": 7200000, "global": 7500000}
      },

      "minRefinementCells": 0,
      "nCellsBetweenLevels": 2,
      "featureLevel": 0,
      "surfaceRefinementLevels": [1, 1],
      "resolveFeatureAngle": 60,

      "nSmoothPatch": 5,
      "tolerance": 3.0,
      "nSolveIter": 500,
      "nRelaxIter": 8,
      "nFeatureSnapIter": 10,

      "explicitFeatureSnap": true,
      "multiRegionFeatureSnap": true,
      "addLayer": 0,
      "_addLayer_note": "Number of boundary layers (0 = none)",

      "useOpenFOAMDefaults": true,
      "relaxed": {
        "maxNonOrtho": 75
      }
    },

    "automatic_refinement": {
      "enabled": true,
      "methodology": "murray_law_based",
      "_methodology_options": ["murray_law_based", "uniform", "adaptive"]
    },

    "cells_per_patch_diameter": {
      "coarse": 10,
      "medium": 14,
      "fine": 18
    }
  },

  "boundary_conditions": {
    "_comment": "Boundary condition specifications",

    "inlet": {
      "type": "TIMEVARYING",
      "_type_options": ["TIMEVARYING", "CONSTANT", "PARABOLIC", "WOMERSLEY"],

      "csv_file": "test_cardio_profile.csv",
      "_csv_file_note": "Name of CSV file in patient folder (for TIMEVARYING)",

      "data_type": "velocity",
      "_data_type_options": ["velocity", "flow_rate"],

      "profile": "womersley",
      "_profile_options": ["plug", "parabolic", "womersley"],
      "_profile_description": {
        "plug": "Uniform velocity profile",
        "parabolic": "Parabolic (Poiseuille) profile",
        "womersley": "Pulsatile Womersley profile (recommended for cardiac)"
      },

      "orientation": "out",
      "_orientation_options": ["in", "out"],
      "_orientation_note": "Direction of normal vector relative to flow",

      "_constant_velocity_settings": {
        "velocity_magnitude": 0.5,
        "_velocity_note": "For CONSTANT inlet type only (m/s)"
      }
    },

    "outlets": {
      "type": "3EWINDKESSEL",
      "_type_options": ["3EWINDKESSEL", "ZEROGRADIENT", "PRESSURE", "FLOWSPLIT"],

      "_zerogradient_settings": {
        "description": "Zero gradient outlet - simplest option"
      },

      "_pressure_settings": {
        "pressure_value": 0,
        "description": "Fixed pressure outlet"
      },

      "_flowsplit_settings": {
        "flow_split": [0.3, 0.25, 0.25, 0.2],
        "description": "Manual flow split ratios (must sum to 1.0)"
      },

      "windkessel_settings": {
        "_comment": "3-Element Windkessel (RCR) boundary condition",

        "systolic_pressure": 120,
        "_systolic_note": "mmHg",
        "diastolic_pressure": 80,
        "_diastolic_note": "mmHg",

        "methodology": "murray_law_automatic",
        "_methodology_options": [
          "murray_law_automatic",
          "manual_rcr_values",
          "manual_flow_split"
        ],

        "_murray_law_automatic": {
          "description": "Automatically calculates RCR values using Murray's Law",
          "murray_exponent": 2.39,
          "_exponent_options": {
            "large_vessels": 2.0,
            "medium_large": 2.2,
            "medium_aorta": 2.39,
            "coronary": 2.5,
            "small_vessels": 2.7
          },
          "reference_radius_strategy": "inlet_based",
          "_strategy_options": ["inlet_based", "min_outlet", "max_outlet", "mean_outlet"]
        },

        "_manual_rcr_values": {
          "description": "Manually specify R1, C, R2 for each outlet",
          "rcr_values": [
            {"R1": 1000, "C": 1e-6, "R2": 5000},
            {"R1": 1200, "C": 1.2e-6, "R2": 6000}
          ]
        },

        "_manual_flow_split": {
          "description": "Specify flow split ratios, auto-calculate RCR",
          "flow_split": [0.3, 0.25, 0.25, 0.2],
          "total_resistance": 10000,
          "total_compliance": 5e-6
        }
      }
    },

    "walls": {
      "type": "no_slip",
      "_type_options": ["no_slip", "slip", "partial_slip"],
      "roughness": 0.0,
      "_roughness_note": "Wall roughness height (m) - 0.0 for smooth walls"
    }
  },

  "simulation_control": {
    "_comment": "Simulation time and control settings",

    "number_of_cycles": 5,
    "_cycles_note": "For cardiac simulations (auto-calculated if omitted)",

    "end_time": 4.0,
    "_end_time_options": ["auto", "<float_value>"],
    "_end_time_note": "'auto' = cycles * cardiac_period, or specify seconds",

    "writeInterval": 0.01,
    "_writeInterval_note": "How often to write results (seconds)",

    "controlDict": {
      "_comment": "OpenFOAM controlDict settings (merged with profile)",
      "application": "foamRun",
      "startFrom": "startTime",
      "startTime": 0.0,
      "stopAt": "endTime",
      "deltaT": 1e-5,
      "_deltaT_note": "Initial time step (seconds)",

      "writeControl": "adjustableRunTime",
      "_writeControl_options": ["timeStep", "runTime", "adjustableRunTime"],

      "runTimeModifiable": true,
      "adjustTimeStep": true,

      "maxCo": 1.0,
      "_maxCo_range": "0.5-2.0 (Courant number limit)",
      "maxDeltaT": 0.0002,

      "functions": ["wallShearStress"],
      "_functions_options": ["wallShearStress", "forceCoeffs", "fieldAverage"]
    }
  },

  "numerical_settings": {
    "_comment": "Numerical schemes and solver settings",

    "time_stepping": "adaptive",
    "_time_stepping_options": ["adaptive", "fixed"],

    "initial_deltaT": 0.001,
    "maxCo": 1.0,
    "maxDeltaT": 0.01,

    "_schemes_override": {
      "ddtSchemes": {"default": "CrankNicolson 0.9"},
      "gradSchemes": {
        "default": "cellLimited Gauss linear 0.5",
        "grad(U)": "cellLimited Gauss linear 1"
      },
      "divSchemes": {
        "default": "none",
        "div(phi,U)": "Gauss linearUpwindV grad(U)",
        "div(phi,k)": "Gauss linearUpwind default",
        "div(phi,omega)": "Gauss linearUpwind default",
        "div((nuEff*dev2(T(grad(U)))))": "Gauss linear"
      },
      "laplacianSchemes": {"default": "Gauss linear limited 1"},
      "interpolationSchemes": {"default": "linear"},
      "snGradSchemes": {"default": "limited 1"}
    },

    "_fvSolution_override": {
      "PIMPLE": {
        "momentumPredictor": true,
        "nOuterCorrectors": 1,
        "nCorrectors": 2,
        "nNonOrthogonalCorrectors": 1
      },
      "solvers": {
        "p": {
          "solver": "GAMG",
          "tolerance": 1e-7,
          "relTol": 0.005,
          "smoother": "GaussSeidel"
        },
        "U": {
          "solver": "smoothSolver",
          "smoother": "symGaussSeidel",
          "tolerance": 1e-7,
          "relTol": 0.05
        }
      },
      "relaxationFactors": {
        "fields": {"p": 0.3},
        "equations": {"U": 0.7, "k": 0.7, "omega": 0.7}
      }
    }
  },

  "output_settings": {
    "_comment": "Post-processing and output control",

    "save_frequency": 10,
    "_save_frequency_note": "Save every Nth timestep",

    "variables": ["velocity", "pressure", "wall_shear_stress"],
    "_variables_options": [
      "velocity",
      "pressure",
      "wall_shear_stress",
      "vorticity",
      "q_criterion",
      "turbulent_kinetic_energy"
    ],

    "post_processing": {
      "generate_report": true,
      "create_animations": false,
      "export_vtk": true,
      "export_csv": true,

