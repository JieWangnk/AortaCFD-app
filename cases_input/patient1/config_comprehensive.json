        "sample_planes": ["inlet", "outlet1"],
        "iso_surfaces": {"WSS": [0.5, 1.0, 2.0]}
      }
    }
  },

  "run_settings": {
    "_comment": "Solver execution settings",

    "solution_type": "parallel",
    "_solution_type_options": ["serial", "parallel"],

    "subdomains": 4,
    "_subdomains_note": "Number of processors for solver (parallel only)",

    "decomposition_method": "scotch",
    "_decomposition_options": ["simple", "hierarchical", "scotch", "metis"],
    "_decomposition_description": {
      "simple": "Simple geometric decomposition",
      "hierarchical": "Hierarchical decomposition",
      "scotch": "Graph-based (recommended)",
      "metis": "Graph-based (alternative to scotch)"
    },

    "_advanced_decomposition": {
      "method": "scotch",
      "scotchCoeffs": {
        "processorWeights": [1, 1, 1, 1]
      }
    }
  },

  "_simulation_profiles": {
