{
  "case_info": {
    "patient_id": "patient1",
    "description": "Simple RANS medium simulation"
  },

  "simulation_settings": {
    "analysis_type": "medium",
    "solver_type": "laminar"
  },

  "physics": {
    "blood_density": 1060,
    "blood_viscosity": 0.004
  },

  "geometry": {
    "rotation": false,
    "scale_factor": 0.001
  },

  "mesh": {
    "mesh_resolution": {
      "target_cell_size_mm": 1.8
    },
    "SNAPPY_SETTINGS": {
      "parallel": false,
      "nProcessors": 1
    }
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "test_cardio_profile.csv",
      "data_type": "velocity",
      "profile": "plug",
      "orientation": "out"
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "methodology": "WKEmpirical",
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "flow_split": 30
      }
    },
    "walls": {
      "type": "no_slip",
      "roughness": 0.0
    }
  },

  "simulation_control": {
    "end_time": "auto",
    "number_of_cycles": 2,
    "writeInterval": 0.05
  },

  "run_settings": {
    "solution_type": "serial",
    "subdomains": 1,
    "decomposition_method": "simple"
  }
}
