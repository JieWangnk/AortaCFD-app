{
  "_comment": "TEST CONFIG - PAT003 - Coarse setup for post-processing verification",
  "_test_purpose": [
    "Quick coarse simulation to verify post-processing module",
    "1.5s end time (3 cardiac cycles at 0.5s each)",
    "Skip 1st cycle, average cycles 2-3 for TAWSS/OSI/RRT",
    "Parallel execution with 4 CPUs"
  ],

  "case_info": {
    "patient_id": "PAT003",
    "description": "Post-processing test - coarse mesh, 1.5s simulation, 4 CPUs"
  },

  "physics": {
    "model": "laminar",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6
    }
  },

  "numerics": {
    "profile": "robust"
  },

  "mesh": {
    "SNAPPY_SETTINGS": {
      "surfaceRefinementLevels": [0, 0]
    },
    "mesh_resolution": {
      "cells_per_diameter": 15
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "PAT003inlet",
    "outlet_keywords_ordered": ["PAT003outlet1", "PAT003outlet2", "PAT003outlet3", "PAT003outlet4"],
    "wall_keywords_ordered": "PAT003wall_aorta",
    "scale_factor": 0.001
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "flowrate.csv",
      "data_type": "flowrate",
      "profile": "wall_distance",
      "cardiac_cycle": 0.5
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 80,
        "diastolic_pressure": 50,
        "venous_pressure": 0,
        "methodology": "murray_law_automatic",
        "tau": 0.5,
        "coupling_mode": "implicit"
      }
    },
    "walls": {
      "type": "no_slip"
    }
  },

  "cardiac_cycle": 0.5,

  "hemodynamics": {
    "_comment": "Test hemodynamics with skip 1 cycle",
    "runtime_functions": {
      "wallShearStress": true,
      "fieldAverage": true,
      "pressureMonitoring": true
    },
    "tawss_settings": {
      "skip_cycles": 1,
      "periodicRestart": true,
      "keep_all_cycles": true
    }
  },

  "simulation_control": {
    "end_time": 1.5,
    "_end_time_comment": "3 cardiac cycles (0.5s each) - skip 1st, average 2nd+3rd",
    "number_of_cycles": 3,
    "writeInterval": 0.1,
    "_writeInterval_comment": "5 outputs per cycle for testing"
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 4
  },

  "visualization": {
    "_comment": "Test all visualization fields",
    "fields": ["U", "p", "wallShearStress", "TAWSS", "OSI", "RRT"],
    "time_steps": "last",
    "color_ranges": {
      "WSS": [0, 50],
      "TAWSS": [0, 50],
      "OSI": [0, 0.5],
      "RRT": [0, 10]
    }
  }
}
