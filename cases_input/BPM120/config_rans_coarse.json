{
  "case_info": {
    "patient_id": "BPM120",
    "description": "Pediatric coarctation of aorta - Laminar Coarse test configuration",
    "reference": "https://doi.org/10.1038/s41598-025-85522-0",
    "heart_rate": 120,
    "notes": "Quick validation test with Laminar solver and Coarse mesh"
  },

  "simulation_settings": {
    "analysis_type": "coarse",
    "solver_type": "rans"
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001,
    "case_name": "BPM120",
    "rotation": false
  },
  "mesh": {
    "resolution_level": "coarse",
    "comment": "Coarse mesh for rapid testing - ~300K cells"
  },
  "physics": {
    "blood_density": 1060,
    "nu": 3.7736e-6,
    "comment": "Pediatric blood properties"
  },
  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "BPM120.csv",
      "data_type": "flowRate",
      "profile": "plug"
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 123,
        "diastolic_pressure": 60,
        "venous_pressure": 0,
        "flow_split": 70,
        "comment": "Let pipeline auto-calculate WK parameters with 70% flow split"
      }
    },
    "walls": {
      "type": "no_slip",
      "comment": "Rigid wall assumption"
    }
  },
  "simulation_control": {
    "end_time": "auto",
    "number_of_cycles": 10,
    "writeInterval": 0.02,
    "comment": "5 cycles for quick validation testing"
  },
  "run_settings": {
    "solution_type": "serial",
    "subdomains": 1,
    "decomposition_method": "simple"
  }
}
