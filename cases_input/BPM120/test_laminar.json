{
  "_comment_header": "=== TEST: LAMINAR PHYSICS MODEL ===",
  "_comment_purpose": "Test laminar physics model (no turbulence) with new config system",
  "_test_objective": "Validate physics.model='laminar' works correctly",
  "_expected": "~2.5M cells, 30-45 min runtime, NO turbulence fields (k, omega)",

  "case_info": {
    "patient_id": "BPM120",
    "description": "TEST: Laminar physics model validation",
    "reference": "Config system implementation test",
    "heart_rate": 120,
    "notes": "Testing laminar model - expects NO turbulence variables"
  },

  "physics": {
    "model": "laminar",
    "_comment_model": "TEST: Laminar flow (no turbulence model)",
    "_expected_fields": "U, p only (NO k, omega, nut)",
    "_note": "Re > 2000 in stenosis may show unphysical results - this is just a test",

    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6,
      "_comment": "Same as RANS for comparison"
    }
  },

  "numerics": {
    "profile": "accurate",
    "_comment_profile": "Standard 2nd order schemes",

    "max_co": 1.0,

    "correctors": {
      "nOuterCorrectors": 3,
      "nCorrectors": 2,
      "nNonOrthogonalCorrectors": 1
    }
  },

  "mesh": {
    "cells_per_diameter": 10,
    "_comment_resolution": "Coarse mesh for quick test (10 cells/D)",
    "_expected_cells": "~2.5M cells",

    "boundary_layers": {
      "enabled": false,
      "_comment_enabled": "Disabled for quick test (BL not critical for laminar)",
      "_note": "Laminar doesn't require y+ control like RANS"
    },

    "surface_refinement": {
      "levels": [1, 2],
      "_comment_levels": "Moderate refinement"
    },

    "SNAPPY_SETTINGS": {
      "_comment_quality": "Using robust defaults (maxBoundarySkewness=8, etc.)",

      "parallel": false,
      "_comment_parallel": "Serial meshing for quick test"
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001,
    "case_name": "BPM120"
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "BPM120.csv",
      "data_type": "flowRate",
      "profile": "plug"
    },

    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 123,
        "diastolic_pressure": 60,
        "venous_pressure": 0,
        "flow_split": 70,
        "flow_split_method": "area",
        "tau": 1.4
      }
    },

    "walls": {
      "type": "no_slip"
    }
  },

  "simulation_control": {
    "end_time": "auto",
    "number_of_cycles": 3,
    "_comment_cycles": "Only 3 cycles for quick test",

    "writeInterval": 0.02,
    "_comment_write": "Write every 0.02s = 50 samples/sec"
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 4,
    "decomposition_method": "scotch",
    "_comment_parallel": "4 cores for quick test"
  },

  "_test_checklist": {
    "1_no_turbulence_fields": "Verify NO k, omega, nut files created",
    "2_only_U_p_fields": "Only U and p fields should exist",
    "3_laminar_fvOptions": "Check fvOptions has NO turbulence sources",
    "4_solver_runs": "Solver completes without turbulence errors",
    "5_compare_rans": "Optional: compare flow patterns with RANS (expect differences in recirculation)"
  },

  "_expected_runtime": "30-45 minutes (mesh: 10 min, solver: 20-35 min on 4 cores)"
}
