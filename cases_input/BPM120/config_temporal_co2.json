{
  "case_info": {
    "patient_id": "BPM120",
    "description": "Temporal convergence study - Co=2.0 (paper Table 5)",
    "study_type": "temporal_convergence"
  },

  "physics": {
    "model": "rans",
    "rans_model": "kOmegaSST",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6
    }
  },

  "numerics": {
    "profile": "standard",
    "max_co": 2.0,
    "_comment": "Temporal study: Co=2.0 (larger time steps)"
