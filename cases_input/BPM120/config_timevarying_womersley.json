{
  "_comment": "TIMEVARYING inlet with Womersley velocity profile",
  "_description": "Analytical pulsatile profile accounting for flow inertia via Womersley number. Uses FFT decomposition of flow waveform.",

  "case_info": {
    "patient_id": "BPM120_timevarying_womersley",
    "description": "Time-varying inlet with Womersley profile"
  },

  "physics": {
    "model": "laminar",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6
    }
  },

  "numerics": {
    "profile": "robust",
    "max_co": 1,
    "correctors": {
      "nOuterCorrectors": 10,
      "nCorrectors": 3,
      "nNonOrthogonalCorrectors": 2
    }
  },

  "mesh": {
    "cells_per_diameter": 1.5,
    "boundary_layers": {
      "enabled": true,
      "num_layers": 5,
      "first_layer_thickness": 0.2,
      "growth_rate": 1.1,
      "relativeSizes": true
    },
    "SNAPPY_SETTINGS": {
      "surfaceRefinementLevels": [2,3],
      "featureLevel": 3,
      "resolveFeatureAngle": 10,
      "includedAngle": 180,
      "parallel": true,
      "nProcessors": 8
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "BPM120.csv",
      "data_type": "flowrate",
      "profile": "womersley",
      "n_harmonics": 20,
      "_comment": "n_harmonics controls FFT accuracy. 20 is usually sufficient for cardiac waveforms."
    },

    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "methodology": "murray_law_automatic",
        "tau": 1.0
      }
    },

    "walls": {
      "type": "no_slip"
    }
  },

  "simulation_control": {
    "end_time": 1.0,
    "number_of_cycles": 2,
    "writeInterval": 0.1
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 8,
    "decomposition_method": "scotch"
  }
}
