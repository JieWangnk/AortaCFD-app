{
  "case_info": {
    "patient_id": "G3",
    "description": "Synthetic benchmark: branched aortic arch with 65% coarctation, pulsatile inlet",
    "source": "AortaCFD-X geometry generation pipeline",
    "clinical_data": {
      "heart_rate": 70,
      "age_group": "young_adult"
    }
  },

  "physics": {
    "model": "laminar",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6,
      "_comment": "Standard blood: rho=1060 kg/m³, mu=0.004 Pa·s → nu=3.77e-6 m²/s"
    }
  },

  "numerics": {
    "profile": "standard",
    "max_co": 1,
    "correctors": {
      "nOuterCorrectors": 5,
      "nCorrectors": 2,
      "nNonOrthogonalCorrectors": 2
    }
  },

  "mesh": {
    "mesh_resolution": {
      "target_cell_size_mm": 1.0
    },
    "boundary_layers": {
      "enabled": false
    },
    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 16,
      "surfaceRefinementLevels": [1, 2]
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001,
    "_comment": "Blender geometry in mm, scale 0.001 to meters. outlet1=descending, outlet2-4=branches"
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "G3_flowrate.csv",
      "data_type": "flowrate",
      "profile": "parabolic"
    },

    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "methodology": "murray_law_automatic",
        "tau": 1.0,
        "enable_stabilization": true
      }
    },

    "walls": {
      "type": "no_slip"
    }
  },

  "simulation_control": {
    "cardiac_cycle_period": 0.857,
    "number_of_cycles": 3,
    "writeInterval": 0.01,
    "_comment": "HR=70 bpm → T=0.857s, write every 0.01s = ~86 writes/cycle, 3 cycles total"
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 16,
    "decomposition_method": "scotch"
  }
}
