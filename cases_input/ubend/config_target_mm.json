{
  "_doc": "Method B — target_cell_size_mm. Absolute size in mm, vessel-independent. Invoke with: python run_patient.py ubend --config cases_input/ubend/config_target_mm.json. Identical physics / BCs / WK auto-calc to config.json — only the mesh block changes.",

  "case_info": {
    "patient_id": "ubend",
    "description": "U-bend 1-cycle laminar pulsatile — Method B (target_cell_size_mm)"
  },

  "physics": {
    "model": "laminar",
    "transport_properties": { "rho": 1060, "nu": 3.7736e-6 }
  },

  "numerics": { "profile": "standard" },

  "mesh": {
    "_doc": "Method B: cell size in mm overrides cells_per_diameter (priority 1 in the 3-priority cascade). target=2.0 mm matches ~cpd=14 on the 27.4 mm inlet diameter, slightly coarser than config.json's cpd=15 for direct comparison.",
    "target_cell_size_mm": 2.0,
    "boundary_layers": {
      "enabled": true, "num_layers": 3, "expansion_ratio": 1.2,
      "final_layer_thickness": 0.3, "min_thickness": 0.05, "relativeSizes": true
    },
    "SNAPPY_SETTINGS": {
      "parallel": true, "nProcessors": 4,
      "surfaceRefinementLevels": [1, 1],
      "featureLevel": 1
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "ubend_inflow.csv",
      "data_type": "flowrate",
      "profile": "parabolic"
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "initial_pressure_method": "map",
        "enable_stabilization": true
      }
    },
    "walls": { "type": "no_slip" }
  },

  "simulation_control": {
    "cardiac_cycle_period": 0.8,
    "number_of_cycles": 1,
    "writeInterval": 0.016,
    "_keep_last_cycles": 1
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 4,
    "decomposition_method": "scotch"
  }
}
