{
  "_doc": "U-bend, laminar pulsatile, 3 cycles, ~2M-cell production mesh, last-cycle snapshots only.",
  "case_info": {
    "patient_id": "ubend",
    "description": "U-bend 3-cycle laminar pulsatile, ~2M cells, last-cycle saves"
  },

  "physics": {
    "model": "laminar",
    "transport_properties": { "rho": 1060, "nu": 3.7736e-6 }
  },

  "numerics": { "profile": "standard" },

  "mesh": {
    "cells_per_diameter": 15,
    "boundary_layers": {
      "enabled": true, "num_layers": 5, "expansion_ratio": 1.2,
      "final_layer_thickness": 0.3, "min_thickness": 0.05, "relativeSizes": true
    },
    "SNAPPY_SETTINGS": {
      "parallel": true, "nProcessors": 4, "surfaceRefinementLevels": [1, 2]
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "ubend_inflow.csv",
      "data_type": "flowrate",
      "profile": "parabolic"
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "_doc": "Auto-calculate mode: outlet_parameters omitted, so wk_setup.py derives Z/C/R from systolic/diastolic + inlet flow (CSV) + outlet geometry (Murray's law) + default PWV formula.",
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "initial_pressure_method": "map",
        "enable_stabilization": true
      }
    },
    "walls": { "type": "no_slip" }
  },

  "simulation_control": {
    "cardiac_cycle_period": 0.8,
    "number_of_cycles": 1,
    "writeInterval": 0.016,
    "_keep_last_cycles": 1
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 4,
    "decomposition_method": "scotch"
  }
}
