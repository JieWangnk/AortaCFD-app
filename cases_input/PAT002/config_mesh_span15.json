{
  "_mesh_study": "cells_across_span = 15 (coarse)",
  "case_info": {
    "patient_id": "PAT002",
    "description": "Adult aortic case from Cape Town collaborator",
    "source": "Clinical collaboration - University of Cape Town",
    "clinical_data": {
      "age_group": "adult"
    }
  },

  "physics": {
    "model": "laminar",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6
    }
  },

  "numerics": {
    "profile": "robust",
    "max_co": 0.5,
    "correctors": {
      "nOuterCorrectors": 10,
      "nCorrectors": 3,
      "nNonOrthogonalCorrectors": 2
    }
  },

  "mesh": {
    "quality_preset": "draft",
    "boundary_layers": {
      "enabled": true,
      "num_layers": 5,
      "expansion_ratio": 1.1,
      "final_layer_thickness": 0.15,
      "min_thickness": 0.01,
      "relativeSizes": true
    },
    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 16,
      "surfaceRefinementLevels": [1, 2],
      "featureLevel": 2,
      "span_refinement_enabled": true,
      "cells_across_span": 15,
      "span_refinement_level": 2,
      "_span_level_note": "Use level 1 or 2 ONLY - level 3 causes skewness > 4.0 (DOE validated)"
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "BPM120.csv",
      "data_type": "flowrate",
      "profile": "wall_distance",
      "exponent": 2.0
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "flow_split": 50,
        "methodology": "murray_law_automatic",
        "tau": 1.0,
        "initial_pressure_method": "diastolic",
        "enable_stabilization": true,
        "stabilization_type": "simple",
        "beta": 1.0,
        "damping_factor": 1.0
      }
    },
    "walls": {
      "type": "no_slip"
    }
  },

  "simulation_control": {
    "end_time": 2.0,
    "number_of_cycles": 5,
    "writeInterval": 0.02
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 16,
    "decomposition_method": "scotch"
  }
}
