{
  "case_info": {
    "patient_id": "PAT002",
    "description": "PAT002 mesh study: cells_per_diameter=12",
    "source": "Clinical collaboration - University of Cape Town",
    "clinical_data": {
      "age_group": "adult"
    }
  },
  "physics": {
    "model": "laminar",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-06,
      "_comment": "Standard blood properties: rho=1060 kg/m\u00b3, mu=0.004 Pa\u00b7s \u2192 nu=3.77e-6 m\u00b2/s"
    }
  },
  "numerics": {
    "profile": "robust",
    "_profile_comment": "Using robust profile for maximum stability with backflow stabilization",
    "max_co": 0.5,
    "_max_co_comment": "Conservative Courant number for early simulation stability",
    "correctors": {
      "nOuterCorrectors": 10,
      "nCorrectors": 3,
      "nNonOrthogonalCorrectors": 2
    },
    "_stability_note": "Increased outer correctors for better pressure-velocity coupling during backflow"
  },
  "mesh": {
    "cells_per_diameter": 12,
    "boundary_layers": {
      "enabled": true,
      "num_layers": 5,
      "expansion_ratio": 1.1,
      "final_layer_thickness": 0.15,
      "min_thickness": 0.01,
      "relativeSizes": true
    },
    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 2,
      "surfaceRefinementLevels": [
        1,
        2
      ],
      "featureLevel": 2
    }
  },
  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": [
      "outlet1",
      "outlet2",
      "outlet3",
      "outlet4"
    ],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001,
    "_comment": "Geometry in mm, scale 0.001 converts to meters"
  },
  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "BPM120.csv",
      "data_type": "flowrate",
      "profile": "wall_distance",
      "exponent": 2.0,
      "_comment": "exponent=2.0 gives parabolic-like shape. Use 1.0 for linear, 1/7 for turbulent."
    },
    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "flow_split": 50,
        "_comment": "flow_split=50 means 50% to branch outlets, 50% to descending aorta (largest outlet)",
        "methodology": "murray_law_automatic",
        "tau": 1.0,
        "initial_pressure_method": "diastolic",
        "_backflow_stabilization_comment": "Two-parameter directional backflow stabilization (Esmaily-Moghadam formulation)",
        "enable_stabilization": true,
        "betaT": 0.3,
        "_betaT_comment": "Tangential damping (0-1). Suppresses spurious vortices during backflow. Recommended: 0.2-0.5",
        "betaN": 0.0,
        "_betaN_comment": "Normal damping (0-1). Keep at 0.0 to preserve Windkessel P-Q coupling. Only increase for severe instability."
      }
    },
    "walls": {
      "type": "no_slip"
    }
  },
  "cardiac_cycle": 0.5,
  "_cardiac_cycle_comment": "120 BPM = 0.5s per cycle",
  "hemodynamics": {
    "_comment": "Enable TAWSS/OSI/RRT computation",
    "runtime_functions": {
      "wallShearStress": true,
      "fieldAverage": true,
      "pressureMonitoring": true
    },
    "tawss_settings": {
      "skip_cycles": 1,
      "_skip_cycles_comment": "Skip 1st cycle for flow development, average cycles 2-3",
      "periodicRestart": true,
      "keep_all_cycles": true
    }
  },
  "simulation_control": {
    "end_time": 0.5,
    "number_of_cycles": 1,
    "writeInterval": 0.02
  },
  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 2,
    "decomposition_method": "scotch"
  },
  "visualization": {
    "_comment": "Post-processing visualization settings",
    "fields": [
      "U",
      "p",
      "wallShearStress",
      "TAWSS",
      "OSI",
      "RRT"
    ],
    "time_steps": "last",
    "_time_steps_comment": "Options: 'last', 'all', 'peak', or list like [1.0, 1.5, 2.0]",
    "color_ranges": {
      "WSS": [
        0,
        50
      ],
      "TAWSS": [
        0,
        50
      ],
      "OSI": [
        0,
        0.5
      ],
      "RRT": [
        0,
        10
      ],
      "_comment": "Adjust ranges based on expected hemodynamic values"
    }
  }
}