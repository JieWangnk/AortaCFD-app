{
  "_purpose": "STABILITY TEST - Robust profile + increased stabilization for PAT002",
  "_framing": [
    "PAT002 failed with standard profile at t=0.068s (early systole).",
    "This config uses maximum-stability settings:",
    "  • Robust profile: Euler + upwind (1st order, high dissipation)",
    "  • Increased betaT: 0.5 (stronger outlet damping)",
    "  • Same mesh as repeatability_demo (reuse via --update)"
  ],

  "case_info": {
    "patient_id": "PAT002",
    "description": "Pediatric case - robust stability test",
    "clinical_data": {
      "age_group": "pediatric",
      "_note": "Child patient - smaller anatomy than adult thoracic aorta"
    }
  },

  "physics": {
    "model": "rans_komegasst",
    "simulation_type": "RAS",
    "_physics_comment": "RANS k-omega SST (same as repeatability baseline)",
    "transport_properties": {
      "rho": 1060,
      "nu": 3.7736e-6,
      "_comment": "Standard blood properties: rho=1060 kg/m³, mu=0.004 Pa·s"
    }
  },

  "numerics": {
    "profile": "robust",
    "_profile_comment": "CHANGE: Robust profile (Euler + upwind) for maximum stability",
    "max_co": 1.0,

    "correctors": {
      "nOuterCorrectors": 10,
      "nCorrectors": 3,
      "nNonOrthogonalCorrectors": 2
    },

    "relaxation_factors": {
      "p": 0.3,
      "U": 0.7
    }
  },

  "mesh": {
    "cells_per_diameter": 18,
    "_mesh_comment": "SAME as repeatability - mesh reused via --update mode",

    "boundary_layers": {
      "enabled": true,
      "num_layers": 10,
      "expansion_ratio": 1.1,
      "final_layer_thickness": 0.15,
      "min_thickness": 0.01,
      "relativeSizes": true
    },

    "SNAPPY_SETTINGS": {
      "parallel": true,
      "nProcessors": 8,
      "surfaceRefinementLevels": [1, 2],
      "featureLevel": 2,
      "span_refinement_enabled": true,
      "cells_across_span": 18
    }
  },

  "geometry": {
    "inlet_keywords_ordered": "inlet",
    "outlet_keywords_ordered": ["outlet1", "outlet2", "outlet3", "outlet4"],
    "wall_keywords_ordered": "wall_aorta",
    "scale_factor": 0.001,
    "_comment": "Geometry in mm, scale to meters"
  },

  "boundary_conditions": {
    "inlet": {
      "type": "TIMEVARYING",
      "csv_file": "BPM120.csv",
      "data_type": "flowrate",
      "profile": "parabolic",
      "_comment": "Same inlet waveform as repeatability baseline"
    },

    "outlets": {
      "type": "3EWINDKESSEL",
      "windkessel_settings": {
        "systolic_pressure": 120,
        "diastolic_pressure": 80,
        "venous_pressure": 0,
        "methodology": "murray_law_automatic",
        "tau": 0.5,
        "initial_pressure_method": "map",

        "enable_stabilization": true,
        "betaT": 0.5,
        "_betaT_comment": "CHANGE: Increased from 0.3 to 0.5 for stronger stabilization",
        "betaN": 0.0,
        "_betaN_comment": "Normal damping = 0.0 (preserves Windkessel P-Q coupling)"
      }
    },

    "walls": {
      "type": "no_slip"
    }
  },

  "hemodynamics": {
    "runtime_functions": {
      "wallShearStress": true,
      "fieldAverage": true,
      "pressureMonitoring": true
    },
    "tawss_settings": {
      "skip_cycles": 1,
      "periodicRestart": true,
      "keep_all_cycles": true
    }
  },

  "simulation_control": {
    "cardiac_cycle_period": 0.5,
    "number_of_cycles": 3,
    "writeInterval": 0.02
  },

  "run_settings": {
    "solution_type": "parallel",
    "subdomains": 40,
    "decomposition_method": "scotch"
  },

  "visualization": {
    "fields": ["U", "p", "wallShearStress", "TAWSS", "OSI", "RRT"],
    "time_steps": "last",
    "color_ranges": {
      "WSS": [0, 50],
      "TAWSS": [0, 30],
      "OSI": [0, 0.5],
      "RRT": [0, 10]
    }
  }
}
